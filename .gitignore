# Secrets and machine-specific settings
.env
# Runtime state. data/apps.yaml IS committed; the database is not.
data/*.db
data/*.db-*
# The docker-socket-proxy's unix socket lives here.
run/*
!run/.gitkeep
# ntfy state: message cache and user database (holds token values)
data/ntfy/
# Secret files generated from .env (tokens, rclone config)
secrets/
# VictoriaMetrics data, backup state/requests
data/vm/
data/alertmanager/
data/backup/
