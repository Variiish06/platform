# Phase 2: dashboard host goes to Portal; apps are still routed directly.
{
    auto_https off
    admin off
    default_bind {$BIND_ADDRS}
}

http://focal.{$DOMAIN} {
    reverse_proxy 127.0.0.1:8787
}
http://ritual.{$DOMAIN} {
    reverse_proxy 127.0.0.1:8090
}
http://git.{$DOMAIN} {
    reverse_proxy 127.0.0.1:3000
}
http://bot.{$DOMAIN} {
    reverse_proxy 127.0.0.1:8080
}
http://{$DOMAIN} {
    reverse_proxy 127.0.0.1:7080
}
http:// {
    respond "unknown host" 404
}
