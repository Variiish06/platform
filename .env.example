# Copy to .env and adjust. .env is gitignored.

# The private domain. Every app lives at <name>.DOMAIN, the dashboard at DOMAIN itself.
DOMAIN=exp.lab

# This machine's Tailscale IPv4 (tailscale ip -4). DNS answers point here.
TS_IP=100.118.33.89

# Network interface that carries the LAN. Caddy also listens on whatever IPv4
# this interface has when Caddy starts (the LAN IP comes from DHCP and can change).
# Leave empty to listen on Tailscale only.
LAN_IFACE=wlp0s20f3

# Group id of the "docker" group on the host (getent group docker).
# Only the socket proxy uses it, to open /var/run/docker.sock.
DOCKER_GID=983

# User/group that owns ~/platform/data (id -u / id -g).
PUID=1000
PGID=1000

# Set to 1 once HTTPS is in place (see README "Adding HTTPS later").
COOKIE_SECURE=0

# Name shown on the login form (single user).
PORTAL_USER=kunchu01

# Timezone for dates shown by Portal.
TZ=Asia/Kolkata
