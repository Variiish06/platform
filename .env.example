# Copy to .env and adjust. .env is gitignored.

# The private domain. Every app lives at <name>.DOMAIN, the dashboard at DOMAIN itself.
DOMAIN=exp.lab

# This machine's Tailscale IPv4 (tailscale ip -4). DNS answers point here.
TS_IP=100.118.33.89

# Network interface that carries the LAN. Caddy also listens on whatever IPv4
# this interface has when Caddy starts (the LAN IP comes from DHCP and can change).
# Leave empty to listen on Tailscale only.
LAN_IFACE=wlp0s20f3

# Group id of the "docker" group on the host (getent group docker).
# Only the socket proxy uses it, to open /var/run/docker.sock.
DOCKER_GID=983

# User/group that owns ~/platform/data (id -u / id -g).
PUID=1000
PGID=1000

# Set to 1 once HTTPS is in place (see README "Adding HTTPS later").
COOKIE_SECURE=0

# Name shown on the login form (single user).
PORTAL_USER=kunchu01

# Timezone for dates shown by Portal.
TZ=Asia/Kolkata

# --- Phase A: ntfy ---
# Leave these EMPTY: scripts/ntfy-provision.sh fills in every empty or missing
# value with a fresh random one (it never changes a value that is set).
# See NOTIFY.md.
# Admin login for the ntfy iPhone app and web app (http://ntfy.exp.lab).
NTFY_ADMIN_USER=kunchu01
# 32 random URL-safe characters.
NTFY_ADMIN_PASSWORD=
# bcrypt hash of the password above ('$2a$10$...'). Hashes contain "$": keep
# them in single quotes, otherwise Compose tries to expand them.
NTFY_ADMIN_PASSWORD_HASH=
# Hash of a random, discarded password shared by the svc-* users (token-only).
NTFY_SVC_PASSWORD_HASH=
# Service tokens, format tk_ + 29 lowercase letters/digits, e.g.
# tk_0123456789abcdefghijklmnopqrs. Each may publish to ONE topic, except
# PORTAL, which may read all six topics and publish to none.
NTFY_TOKEN_PORTAL=
NTFY_TOKEN_ALERTS=
NTFY_TOKEN_BACKUP=
NTFY_TOKEN_FOCAL=
NTFY_TOKEN_RITUAL=
NTFY_TOKEN_DALAL=
NTFY_TOKEN_GENERAL=
